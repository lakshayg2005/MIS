# Copy to .env (git-ignored). Without a key the app still starts but uses the offline fake LLM.
LLM_PROVIDER=groq
LLM_API_KEY=your-groq-key-here
# Optional:
# LLM_MODEL=qwen/qwen3.8-27b        # default; openai/gpt-oss-20b also works (earlier evaluation runs). Free-tier daily token limits apply per model.
# RETRIEVAL_MODE=vector        # or hybrid
# JWT_SECRET=change-me-to-a-long-random-string
